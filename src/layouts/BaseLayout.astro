---
import "@/styles/global.css";
import BaseHead from "@/components/utility/BaseHead.astro";
import { Font } from "astro:assets";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps;

const seo = Astro.props;
---

<!doctype html>
<html lang="fr" class="theme-light">
  <head>
    <BaseHead {...seo} />
    <meta name="theme-color" content="#e4d1a6" />
    <Font cssVariable="--font-garamond" preload />
    <Font cssVariable="--font-cormorant" preload />
    <slot name="head" />
  </head>
  <body>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
