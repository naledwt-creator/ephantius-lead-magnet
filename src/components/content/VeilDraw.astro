---
/**
 * Les Trois Voiles : le visiteur entre sa date de naissance, les trois lames
 * se calculent (voir `veilsOf` dans le script). Seul le premier voile, le
 * Reflet, se retourne et se lit en trois gestes ; la Vérité, le Devenir et la
 * Clé restent cachés, à lever au stand. Le calcul ne dépend que de la date :
 * Éphantius retombe sur les mêmes lames. Rien n'est envoyé ni enregistré.
 */
import { getImage } from "astro:assets";
import { ARCANES, cardImg } from "@/data/arcanes.ts";
import Glyph from "@/components/global/Glyph.astro";
import Button from "@/components/Button.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const VEILS = [
  { key: "verite", no: "II", name: "Vérité", place: "is-left" },
  { key: "reflet", no: "I", name: "Reflet", place: "is-center" },
  { key: "devenir", no: "III", name: "Devenir", place: "is-right" },
];

const faces = await Promise.all(
  ARCANES.map(async (a) => ({
    n: a.n,
    numeral: a.numeral,
    name: a.name,
    look: a.look,
    feel: a.feel,
    link: a.link,
    src: (await getImage({ src: cardImg(a.n), width: 480, format: "webp", quality: 72 })).src,
  })),
);
---

{render && (
  <section class="veil_wrap" data-veil data-state="ask" aria-labelledby="veil-title">
    <div class="veil_intro">
      <p class="veil_kicker">par Éphantius Lémurien</p>
      <h1 class="veil_title" id="veil-title">Vos Trois<br /><span>Voiles</span></h1>
      <p class="veil_lede">Ni voyance, ni prédiction. Le premier se lève ici, les deux autres au stand.</p>
    </div>

    <div class="veil_stage">
      <svg class="veil_chart" viewBox="0 0 200 200" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-width="0.6">
          <rect x="8" y="8" width="184" height="184" />
          <path d="M8 8 192 192M192 8 8 192M100 8 192 100 100 192 8 100Z" />
          <rect x="54" y="54" width="92" height="92" stroke-dasharray="1.5 2" />
        </g>
        <g fill="currentColor" font-family="Georgia, serif" font-size="7" text-anchor="middle">
          <text x="100" y="40">♈︎ 21</text><text x="52" y="30">♊︎ 17</text><text x="148" y="30">♋︎ 4</text>
          <text x="30" y="70">☽︎ 10</text><text x="170" y="70">♄︎ 22</text><text x="30" y="132">♀︎ 8</text>
          <text x="170" y="132">♃︎ 31</text><text x="100" y="168">☉︎ 23</text><text x="52" y="178">♍︎ 4</text>
          <text x="148" y="178">♏︎ 18</text>
          <text x="44" y="102" font-style="italic" font-size="6">Capella</text>
          <text x="157" y="102" font-style="italic" font-size="6">Orion</text>
        </g>
      </svg>
      {VEILS.map((v) => (
        <div class:list={["veil_card", v.place]} data-card={v.key}>
          <span class="veil_card_inner">
            <span class="veil_face veil_back" aria-hidden="true">
                <svg viewBox="0 0 100 183" preserveAspectRatio="none">
                  <rect x="1" y="1" width="98" height="181" fill="#efe2c2" stroke="#4f4636" stroke-width="1.2" />
                  <rect x="5" y="5" width="90" height="173" fill="#3d3f70" />
                  <rect x="8" y="8" width="84" height="167" fill="none" stroke="#efe2c2" stroke-width="0.6" />
                  <g stroke="#efe2c2" stroke-width="0.35" opacity="0.55">
                    <path d="M8 30 92 114M8 58 92 142M8 86 92 170M8 114 69 175M8 142 41 175M8 170 13 175M36 8 92 64M64 8 92 36M8 8 92 92" />
                    <path d="M92 30 8 114M92 58 8 142M92 86 8 170M92 114 31 175M92 142 59 175M92 170 87 175M64 8 8 64M36 8 8 36M92 8 8 92" />
                  </g>
                  <circle cx="50" cy="91.5" r="22" fill="#3d3f70" stroke="#efe2c2" stroke-width="0.8" />
                  <circle cx="50" cy="91.5" r="18" fill="none" stroke="#efe2c2" stroke-width="0.4" />
                  <path d="M50 74l3 14 14 3.5-14 3.5-3 14-3-14-14-3.5 14-3.5Z" fill="#e4d1a6" />
                  <path d="M50 81l1.6 8.6 8.4 1.9-8.4 1.9L50 102l-1.6-8.6-8.4-1.9 8.4-1.9Z" fill="#7a1c1c" transform="rotate(45 50 91.5)" />
                  <text x="50" y="22" fill="#efe2c2" font-family="Georgia, serif" font-size="6.5" text-anchor="middle" letter-spacing="1.5">ORATORIUM</text>
                  <text x="50" y="166" fill="#efe2c2" font-family="Georgia, serif" font-size="5" text-anchor="middle" letter-spacing="1.2">ÉPHANTIUS</text>
                </svg>
              </span>
            {v.key === "reflet" && <span class="veil_face veil_front"><img data-img alt="" width="480" height="878" decoding="async" /></span>}
          </span>
          <span class="veil_tag"><span class="veil_tag_no">{v.no}</span> {v.name}</span>
        </div>
      ))}
    </div>

    <form class="veil_ask" data-form novalidate>
      <p class="veil_ask_label" id="veil-ask">Votre date de naissance</p>
      <div class="veil_fields" role="group" aria-labelledby="veil-ask">
        <input aria-label="Jour" inputmode="numeric" data-max="2" placeholder="JJ" autocomplete="bday-day" />
        <span aria-hidden="true">/</span>
        <input aria-label="Mois" inputmode="numeric" data-max="2" placeholder="MM" autocomplete="bday-month" />
        <span aria-hidden="true">/</span>
        <input aria-label="Année" inputmode="numeric" data-max="4" placeholder="AAAA" autocomplete="bday-year" class="is-year" />
      </div>
      <p class="veil_error" data-error role="alert" hidden>Vérifiez la date : jour, mois, puis l'année sur quatre chiffres.</p>
      <Button type="submit">Lever mon premier voile</Button>
    </form>

    <div class="veil_reading" data-reading hidden>
      <p class="veil_date">Premier voile · votre Reflet</p>
      <p class="veil_sub">Ce que les autres voient de vous</p>
      <h2 class="veil_name" tabindex="-1">
        <span class="veil_numeral" data-numeral></span>
        <span data-name></span>
      </h2>

      <div class="veil_triad">
        <div class="veil_gesture">
          <h3 class="veil_gesture_title">Regarder</h3>
          <Glyph name="mercury" class="veil_glyph" />
          <p data-look></p>
        </div>
        <div class="veil_gesture">
          <h3 class="veil_gesture_title">Ressentir</h3>
          <Glyph name="moon" class="veil_glyph" />
          <p data-feel></p>
        </div>
      </div>

      <div class="veil_question">
        <h3 class="veil_gesture_title">Relier</h3>
        <Glyph name="sun" class="veil_glyph" />
        <p class="veil_you">Et vous,</p>
        <p class="veil_link" data-link></p>
      </div>

      <p class="veil_motto">Une lame ne prédit rien.<br />Elle vous regarde.</p>

      <div class="veil_rest">
        <p class="veil_rest_title">Il reste deux voiles</p>
        <p>Votre <strong>Vérité</strong>, ce que vous êtes. Votre <strong>Devenir</strong>, ce vers quoi vous tendez. Et votre <strong>Clé</strong>, l'arcane qui relie les trois.</p>
        <p>Venez les lever au <strong>stand 114</strong>. Donnez votre date de naissance à Éphantius : il retombera sur les mêmes lames.</p>
        <p class="veil_birth" data-birth></p>
      </div>
      <button type="button" class="veil_again" data-again>Essayer une autre date</button>
    </div>

    <script type="application/json" id="veil-faces" set:html={JSON.stringify(faces)} />
  </section>
)}

<script>
  type Face = { n: number; numeral: string; name: string; look: string; feel: string; link: string; src: string };

  const root = document.querySelector<HTMLElement>("[data-veil]");
  if (root) {
    const faces: Face[] = JSON.parse(document.getElementById("veil-faces")?.textContent ?? "[]");
    const card = root.querySelector<HTMLElement>('[data-card="reflet"]')!;
    const img = root.querySelector<HTMLImageElement>("[data-img]")!;
    const form = root.querySelector<HTMLFormElement>("[data-form]")!;
    const error = root.querySelector<HTMLElement>("[data-error]")!;
    const reading = root.querySelector<HTMLElement>("[data-reading]")!;
    const fields = Array.from(form.querySelectorAll<HTMLInputElement>("input"));
    const $ = (k: string) => root.querySelector<HTMLElement>(`[data-${k}]`)!;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const wait = (ms: number) => new Promise((r) => window.setTimeout(r, reduce ? 0 : ms));

    const pad = (n: number) => String(n).padStart(2, "0");
    const sumDigits = (s: string) => s.split("").reduce((t, d) => t + Number(d), 0);
    // Réduction classique du Tarot de Marseille : on additionne les chiffres
    // tant que le total dépasse 22 ; 22 est Le Mat (sans numéro, noté 0).
    const arcane = (n: number) => {
      while (n > 22) n = sumDigits(String(n));
      return n === 22 ? 0 : n;
    };
    const value = (n: number) => (n === 0 ? 22 : n);
    // Les Trois Voiles et la Clé, calculés sur la seule date de naissance.
    const veilsOf = (d: number, m: number, y: number) => {
      const reflet = arcane(d);
      const verite = arcane(sumDigits(`${pad(d)}${pad(m)}${y}`));
      const devenir = arcane(value(reflet) + value(verite));
      const cle = arcane(value(reflet) + value(verite) + value(devenir));
      return { reflet, verite, devenir, cle };
    };

    fields.forEach((input, i) => {
      input.addEventListener("input", () => {
        const max = Number(input.dataset.max);
        const digits = input.value.replace(/\D/g, "");
        input.value = digits.slice(0, max);
        const next = fields[i + 1];
        if (digits.length >= max && next) {
          if (digits.length > max) {
            next.value = digits.slice(max);
            next.dispatchEvent(new Event("input"));
          }
          next.focus();
        }
      });
      input.addEventListener("keydown", (e) => {
        if (e.key === "Backspace" && !input.value && i > 0) fields[i - 1].focus();
      });
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const now = new Date();
      const [d, m, y] = fields.map((f) => Number(f.value));
      const date = new Date(y, m - 1, d);
      const ok = fields[2].value.length === 4 && y >= 1900 && y <= now.getFullYear() && date.getDate() === d && date.getMonth() === m - 1;
      error.hidden = ok;
      if (!ok) return;

      const veils = veilsOf(d, m, y);
      root.dataset.veils = `${veils.reflet}-${veils.verite}-${veils.devenir}-${veils.cle}`;
      const face = faces.find((f) => f.n === veils.reflet) ?? faces[0];
      fields.forEach((f) => f.blur());
      img.src = face.src;
      img.alt = `${face.name}, Tarot de Jean Dodal`;
      // On n'attend jamais plus de 1,5 s une image lente (réseau du salon).
      await Promise.race([img.decode().catch(() => undefined), new Promise((r) => window.setTimeout(r, 1500))]);

      $("birth").textContent = `Votre date : ${pad(d)} / ${pad(m)} / ${y}`;
      $("numeral").textContent = face.numeral || "Sans numéro";
      $("name").textContent = face.name;
      $("look").textContent = face.look;
      $("feel").textContent = face.feel;
      $("link").textContent = face.link.charAt(0).toLowerCase() + face.link.slice(1);

      root.dataset.state = "revealed";
      form.hidden = true;
      card.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "center" });
      await wait(350);
      card.classList.add("is-flipped");
      await wait(950);
      reading.hidden = false;
      reading.classList.add("is-entering");
    });

    $("again").addEventListener("click", () => {
      card.classList.remove("is-flipped");
      reading.hidden = true;
      reading.classList.remove("is-entering");
      form.hidden = false;
      root.dataset.state = "ask";
      fields.forEach((f) => (f.value = ""));
      root.scrollIntoView({ behavior: reduce ? "auto" : "smooth" });
    });
  }
</script>

<style is:global>
  @layer components {
    .veil_wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .veil_intro {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.9rem;
    }
    .veil_kicker {
      order: 2;
      font-family: var(--display-family);
      font-size: 1.2rem;
      color: var(--burgundy-600);
    }
    .veil_title {
      order: 1;
      font-family: var(--display-family);
      font-weight: 500;
      font-size: clamp(3rem, 14vw, 5.6rem);
      line-height: 0.86;
      text-transform: uppercase;
      letter-spacing: 0.01em;
      color: var(--ink-700);
      text-box: trim-both cap alphabetic;
      span {
        font-size: 0.72em;
        color: var(--burgundy-600);
        letter-spacing: 0.03em;
      }
    }
    .veil_lede {
      order: 3;
      max-width: 22ch;
      font-family: var(--display-family);
      font-style: italic;
      font-size: clamp(1.45rem, 5.6vw, 1.9rem);
      line-height: 1.15;
      color: var(--ink-700);
    }

    .veil_stage {
      position: relative;
      container-type: inline-size;
      width: min(100%, 28rem);
      aspect-ratio: 1 / 0.98;
      margin-top: 1.5rem;
      perspective: 160cqw;
    }
    .veil_chart {
      position: absolute;
      inset: 9cqw 2cqw auto;
      width: 96cqw;
      color: var(--indigo-600);
      opacity: 0.55;
      transition: opacity 900ms var(--_ease, ease);
      pointer-events: none;
    }
    .veil_wrap[data-state="revealed"] .veil_chart {
      opacity: 0.32;
    }
    .veil_card {
      position: absolute;
      left: 30cqw;
      top: 6cqw;
      z-index: 2;
      width: 40cqw;
      aspect-ratio: 480 / 878;
      transform-style: preserve-3d;
      animation: veil-deal 900ms cubic-bezier(0.22, 1, 0.36, 1) 200ms backwards;
      &.is-left,
      &.is-right {
        z-index: 1;
        top: 20cqw;
        width: 27cqw;
        animation-delay: 380ms;
        .veil_card_inner {
          rotate: var(--_tilt);
        }
      }
      &.is-left {
        --_tilt: -8deg;
        left: 2cqw;
      }
      &.is-right {
        --_tilt: 8deg;
        left: 71cqw;
      }
    }
    .veil_wrap[data-state="revealed"] .veil_card:is(.is-left, .is-right) {
      opacity: 0.75;
      transition: opacity 600ms ease;
    }
    .veil_tag {
      position: absolute;
      top: calc(100% + 3cqw);
      left: 50%;
      translate: -50% 0;
      white-space: nowrap;
      font-family: var(--display-family);
      font-size: 4cqw;
      font-weight: 600;
      line-height: 1;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ink-700);
      .is-center & {
        font-size: 5.4cqw;
        color: var(--burgundy-600);
      }
    }
    .veil_tag_no {
      color: var(--burgundy-600);
      letter-spacing: 0.12em;
    }
    .veil_card_inner {
      position: absolute;
      inset: 0;
      transform-style: preserve-3d;
      transition: transform 900ms cubic-bezier(0.65, 0, 0.35, 1);
    }
    .veil_card.is-flipped .veil_card_inner {
      transform: rotateY(180deg);
    }
    .veil_face {
      position: absolute;
      inset: 0;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      box-shadow: 0 0.6cqw 1.2cqw rgb(46 43 31 / 0.3);
      svg {
        width: 100%;
        height: 100%;
      }
    }
    .veil_front {
      transform: rotateY(180deg);
      padding: 1.6cqw;
      background: linear-gradient(135deg, #e6e0d2, #b9b2a2 45%, #ddd7c8 70%, #a8a191);
      outline: 0.25cqw solid var(--frame-700);
      outline-offset: -0.25cqw;
      img {
        height: 100%;
        outline: 0.25cqw solid var(--frame-700);
      }
    }

    .veil_ask {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      margin-top: 1.75rem;
    }
    .veil_ask_label {
      font-family: var(--display-family);
      font-style: italic;
      font-size: 1.45rem;
      line-height: 1.1;
      color: var(--burgundy-600);
    }
    .veil_fields {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-family: var(--display-family);
      font-size: 1.6rem;
      color: var(--ink-500);
      input {
        width: 3.6rem;
        min-height: 3.4rem;
        padding: 0.3rem;
        font-family: var(--display-family);
        font-size: 1.7rem;
        font-weight: 500;
        font-variant-numeric: lining-nums;
        text-align: center;
        color: var(--ink-900);
        background: color-mix(in srgb, var(--parchment-100) 75%, transparent);
        border: var(--border-width) solid var(--frame-700);
        border-radius: var(--radius-control);
        &.is-year {
          width: 5.6rem;
        }
        &::placeholder {
          color: var(--parchment-400);
        }
      }
    }
    .veil_error {
      max-width: 30ch;
      font-size: 1rem;
      color: var(--burgundy-600);
    }
    .veil_reading {
      width: 100%;
      scroll-margin-top: 1rem;
      &.is-entering > * {
        animation: veil-rise 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
      }
      &.is-entering > :nth-child(2) { animation-delay: 80ms; }
      &.is-entering > :nth-child(3) { animation-delay: 200ms; }
      &.is-entering > :nth-child(4) { animation-delay: 320ms; }
      &.is-entering > :nth-child(n + 5) { animation-delay: 440ms; }
    }
    .veil_date {
      font-family: var(--display-family);
      font-size: 1.15rem;
      color: var(--burgundy-600);
      &::first-letter {
        text-transform: uppercase;
      }
    }
    .veil_sub {
      margin-top: 0.5rem;
      font-style: italic;
      color: var(--text-2);
    }
    .veil_rest {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.8rem;
      margin-top: 2.25rem;
      padding: 1.75rem 1.25rem;
      border: var(--border-width) solid var(--frame-700);
      outline: var(--border-width) solid var(--frame-700);
      outline-offset: -0.35rem;
      p {
        max-width: 32ch;
        line-height: 1.35;
      }
      strong {
        font-weight: 500;
        color: var(--burgundy-600);
      }
    }
    .veil_rest_title {
      font-family: var(--display-family);
      font-style: italic;
      font-weight: 600;
      font-size: clamp(1.9rem, 8vw, 2.4rem);
      line-height: 1;
      color: var(--indigo-600);
    }
    .veil_birth {
      font-family: var(--display-family);
      font-size: 1.15rem;
      font-variant-numeric: lining-nums;
      letter-spacing: 0.06em;
      color: var(--ink-500);
    }
    .veil_name {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.6rem;
      margin-top: 1rem;
      font-family: var(--display-family);
      font-weight: 500;
      font-size: clamp(2.6rem, 11vw, 4rem);
      line-height: 0.95;
      text-transform: uppercase;
      color: var(--burgundy-600);
      outline: none;
    }
    .veil_numeral {
      font-size: 1.2rem;
      letter-spacing: 0.25em;
      color: var(--ink-700);
      font-variant-numeric: lining-nums;
    }

    .veil_triad {
      display: grid;
      margin-top: 2.25rem;
      @media (width >= 34rem) {
        grid-template-columns: 1fr 1fr;
      }
    }
    .veil_gesture {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.9rem;
      padding: 1.5rem 0.75rem;
      & + & {
        border-top: var(--border-width) solid var(--border);
        @media (width >= 34rem) {
          border-top: 0;
          border-left: var(--border-width) solid var(--border);
        }
      }
      p {
        max-width: 28ch;
        line-height: 1.35;
      }
    }
    .veil_gesture_title {
      font-family: var(--display-family);
      font-weight: 600;
      font-size: 1.3rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      text-decoration: underline;
      text-decoration-thickness: 0.06em;
      text-underline-offset: 0.3em;
      color: var(--ink-900);
    }
    .veil_glyph {
      font-size: 3rem;
      color: var(--indigo-600);
    }
    .veil_question {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.9rem;
      padding: 1.75rem 0 0.5rem;
      border-top: var(--border-width) solid var(--border);
    }
    .veil_you {
      margin-top: 0.5rem;
      font-family: var(--display-family);
      font-size: clamp(2rem, 9vw, 2.8rem);
      line-height: 1;
      text-transform: uppercase;
      color: var(--indigo-600);
    }
    .veil_link {
      max-width: 20ch;
      font-family: var(--display-family);
      font-size: clamp(1.6rem, 6.8vw, 2.3rem);
      line-height: 1.08;
      color: var(--burgundy-600);
      text-wrap: balance;
    }
    .veil_motto {
      margin-top: 2rem;
      font-family: var(--display-family);
      font-weight: 500;
      font-size: clamp(1.25rem, 5vw, 1.55rem);
      line-height: 1.15;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      color: var(--ink-900);
    }
    .veil_again {
      margin-top: 2rem;
      font-family: var(--display-family);
      font-size: 1.3rem;
