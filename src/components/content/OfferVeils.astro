---
/**
 * Les deux lectures proposées au stand, présentées comme deux petites
 * affiches numérotées de l'Oratorium.
 */
import { LECTURES, SALON } from "@/data/salon.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{render && (
  <section class="offers_wrap" aria-labelledby="offers-title">
    <h2 class="offers_title" id="offers-title">Une lame lève un voile.<br /><span>Il en reste deux.</span></h2>
    <p class="offers_intro">Il y a la vie qu'on mène. Et celle qu'on s'était promise. Pour aller plus loin que la lame du jour :</p>
    <ul class="offers_list">
      {LECTURES.map((l) => (
        <li class="offers_item">
          <p class="offers_no"><i>N</i><sup>o</sup>{l.no}</p>
          <h3 class="offers_name">{l.name}</h3>
          <p class="offers_line">{l.line}</p>
          <p class="offers_detail">{l.detail}</p>
          <p class="offers_price">{l.price}€</p>
        </li>
      ))}
    </ul>
    <p class="offers_note">Sur rendez-vous. Réservation sur place, au stand {SALON.stand}.</p>
  </section>
)}

<style is:global>
  @layer components {
    .offers_wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .offers_title {
      font-family: var(--display-family);
      font-weight: 500;
      font-size: clamp(2rem, 8.6vw, 3rem);
      line-height: 1;
      text-transform: uppercase;
      color: var(--indigo-600);
      span {
        color: var(--burgundy-600);
      }
    }
    .offers_intro {
      max-width: 32ch;
      margin-top: 1.25rem;
      line-height: 1.35;
    }
    .offers_list {
      display: grid;
      gap: 1rem;
      width: 100%;
      margin-top: 2rem;
      @media (width >= 34rem) {
        grid-template-columns: 1fr 1fr;
      }
    }
    .offers_item {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      padding: 1.75rem 1.25rem 1.5rem;
      background: color-mix(in srgb, var(--parchment-100) 55%, transparent);
      border: var(--border-width) solid var(--frame-700);
      outline: var(--border-width) solid var(--frame-700);
      outline-offset: -0.35rem;
    }
    .offers_no {
      position: absolute;
      top: 0.7rem;
      left: 0.9rem;
      font-family: var(--display-family);
      font-style: italic;
      font-size: 0.95rem;
      color: var(--burgundy-600);
      sup {
        text-decoration: underline;
      }
    }
    .offers_name {
      margin-top: 0.5rem;
      font-family: var(--display-family);
      font-weight: 600;
      font-size: 1.7rem;
      line-height: 1;
      text-transform: uppercase;
      color: var(--burgundy-600);
    }
    .offers_line {
      line-height: 1.3;
    }
    .offers_detail {
      font-size: 0.95rem;
      color: var(--burgundy-700);
    }
    .offers_price {
      font-family: var(--display-family);
      font-weight: 600;
      font-size: 2.8rem;
      line-height: 1;
      color: var(--burgundy-600);
    }
    .offers_note {
      margin-top: 1.5rem;
      font-size: 1.05rem;
      color: var(--ink-700);
    }
  }
</style>
